<!DOCTYPE html>
<html lang="es">
<body style="margin:0;padding:24px;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
    <div style="max-width:620px;margin:0 auto;background:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e5e7eb;">
        <div style="background:#1d4ed8;color:#ffffff;padding:20px 24px;">
            <h1 style="margin:0;font-size:20px;">Task Manager</h1>
            <p style="margin:6px 0 0;font-size:14px;opacity:.9;">Actualización de estado de una tarea</p>
        </div>
        <div style="padding:24px;">
            <p style="margin-top:0;">Hola {{ admin.name }},</p>
            <p>
                <strong>{{ actor.name }}</strong> actualizó el estado de la tarea
                <strong>"{{ task.title }}"</strong>.
            </p>
            <table style="width:100%;border-collapse:collapse;margin:18px 0;">
                <tr>
                    <td style="padding:8px 0;color:#6b7280;">Estado anterior</td>
                    <td style="padding:8px 0;text-align:right;">{{ previousStatus.label }}</td>
                </tr>
                <tr>
                    <td style="padding:8px 0;color:#6b7280;">Estado nuevo</td>
                    <td style="padding:8px 0;text-align:right;"><strong>{{ newStatus.label }}</strong></td>
                </tr>
                <tr>
                    <td style="padding:8px 0;color:#6b7280;">Trabajador asignado</td>
                    <td style="padding:8px 0;text-align:right;">{{ task.assignedTo ? task.assignedTo.name : '-' }}</td>
                </tr>
                <tr>
                    <td style="padding:8px 0;color:#6b7280;">Rango de ejecución</td>
                    <td style="padding:8px 0;text-align:right;">
                        {{ task.startAt|date('d/m/Y H:i') }} - {{ task.endAt|date('d/m/Y H:i') }}
                    </td>
                </tr>
            </table>
            {% if task.description %}
                <p style="color:#374151;"><strong>Descripción:</strong> {{ task.description }}</p>
            {% endif %}
            {% if newStatus.value == 'finished' %}
                <p style="background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46;padding:12px;border-radius:8px;">
                    El trabajador marcó la tarea como terminada. Puedes validarla desde
                    <code>POST /api/tasks/{{ task.id }}/validate</code>.
                </p>
            {% endif %}
        </div>
        <div style="padding:14px 24px;background:#f9fafb;color:#6b7280;font-size:12px;">
            Correo automático de Task Manager. No respondas a este mensaje.
        </div>
    </div>
</body>
</html>
